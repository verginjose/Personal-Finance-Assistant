# Template for the repo-root .env. Copy it and fill in real values:
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored and stays on your machine. Secrets reach the cluster only
# through the encrypted files in k8s/sealed/, generated by ./k8s/seal-secrets.sh.
#
# Replace every CHANGE-ME before the first deploy.

# ── Database ────────────────────────────────────────────────────────────────
DB_NAME=pfa_db
DB_USER=pfa_admin
DB_PASSWORD=CHANGE-ME
DB_HOST_PORT=5432

# ── Database schemas ────────────────────────────────────────────────────────
AUTH_DB_SCHEMA=auth
FINANCE_DB_SCHEMA=finance

# ── JWT ─────────────────────────────────────────────────────────────────────
# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=CHANGE-ME
JWT_EXPIRATION=86400000

# ── Redis (leave empty for no auth) ─────────────────────────────────────────
REDIS_PASSWORD=CHANGE-ME

# ── External APIs (Groq) ────────────────────────────────────────────────────
GROQ_API_KEY=CHANGE-ME
GROQ_MODEL=openai/gpt-oss-120b
GROQ_URL=https://api.groq.com/openai/v1/chat/completions

# ── Service ports (docker-compose only; k8s uses its own Service ports) ─────
API_GATEWAY_PORT=8080
UPSERT_SERVICE_PORT=8081
AUTH_SERVICE_PORT=8082
OCR_SERVICE_PORT=8083
ANALYTICS_SERVICE_PORT=8084

# ── Cloudflare tunnel (optional; only with k8s/optional/cloudflared.yaml) ───
CLOUDFLARE_TUNNEL_TOKEN=CHANGE-ME

# ── Observability ───────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=CHANGE-ME
CLICKHOUSE_PASSWORD=CHANGE-ME

# ── Object storage ──────────────────────────────────────────────────────────
MINIO_ROOT_PASSWORD=CHANGE-ME

# ── CI: GitHub PAT for the self-hosted runner ───────────────────────────────
# Fine-grained: this repo; Administration R/W (register the runner) and
# Contents R/W (push the image-tag bump). Classic: `repo` scope.
GITHUB_PAT=CHANGE-ME
