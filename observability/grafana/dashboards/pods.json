{
  "uid": "pfa-pods",
  "title": "Pods \u2014 App, CI & Infrastructure",
  "tags": [
    "pods",
    "cadvisor",
    "kubernetes",
    "argocd-groups"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "app_group",
        "label": "Workload group",
        "type": "custom",
        "query": "All : .*, pfa-apps : ^(auth-service|edge-router|command-service|query-service|frontend|storage-service|ocr-service)-.*, ci : ^(ci-runner|cargo-proxy|registry-proxy|registry|buildkitd|buildkit-prune|registry-gc|mirror-base-images)-.*, infra : ^(postgres-primary|postgres-replica|redis|rabbitmq|minio|clickhouse|prometheus|grafana|vector|cloudflared)-.*",
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": ".*"
          },
          {
            "selected": false,
            "text": "pfa-apps",
            "value": "^(auth-service|edge-router|command-service|query-service|frontend|storage-service|ocr-service)-.*"
          },
          {
            "selected": false,
            "text": "ci",
            "value": "^(ci-runner|cargo-proxy|registry-proxy|registry|buildkitd|buildkit-prune|registry-gc|mirror-base-images)-.*"
          },
          {
            "selected": false,
            "text": "infra",
            "value": "^(postgres-primary|postgres-replica|redis|rabbitmq|minio|clickhouse|prometheus|grafana|vector|cloudflared)-.*"
          }
        ],
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        },
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-ds"
        },
        "query": "query_result(max by (pod) (container_last_seen{namespace=~\"pfa|pfa-system\",pod=~\"${app_group:raw}\"}) > time() - 120)",
        "definition": "query_result(max by (pod) (container_last_seen{namespace=~\"pfa|pfa-system\",pod=~\"${app_group:raw}\"}) > time() - 120)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "regex": "/pod=\"([^\"]+)\"/",
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "CPU used (cores)",
      "description": "Cores actually used right now, summed over the selected pods.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "id": 1,
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          },
          "expr": "sum((rate(container_cpu_usage_seconds_total{namespace=~\"pfa|pfa-system\",pod=~\"$pod\",container!=\"\",container!=\"POD\"}[5m])) and on(pod) (max by (pod) (container_last_seen{namespace=~\"pfa|pfa-system\"} @ end()) > scalar(max(timestamp(container_last_seen{namespace=~\"pfa|pfa-system\"} @ end()))) - 120))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "Memory used",
      "description": "Working set summed over the selected pods. Use Memory usage % by pod below to assess pressure against each pod limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          },
          "expr": "sum((container_memory_working_set_bytes{namespace=~\"pfa|pfa-system\",pod=~\"$pod\",container!=\"\",container!=\"POD\"}) and on(pod) (max by (pod) (container_last_seen{namespace=~\"pfa|pfa-system\"} @ end()) > scalar(max(timestamp(container_last_seen{namespace=~\"pfa|pfa-system\"} @ end()))) - 120))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "Restarts (1h)",
      "description": "Container restarts in the last hour. Above 0 deserves a `kubectl describe`.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          },
          "expr": "sum((changes(container_start_time_seconds{namespace=~\"pfa|pfa-system\",pod=~\"$pod\",container!=\"\",container!=\"POD\"}[1h])) and on(pod) (max by (pod) (container_last_seen{namespace=~\"pfa|pfa-system\"} @ end()) > scalar(max(timestamp(container_last_seen{namespace=~\"pfa|pfa-system\"} @ end()))) - 120))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU usage % by pod",
      "description": "CPU use as a percentage of each pod limit. Use the Workload group selector to reduce clutter.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          },
          "expr": "(100 * (sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=~\"pfa|pfa-system\",pod=~\"$pod\",container!=\"\",container!=\"POD\"}[5m]))) / (sum by (pod) (container_spec_cpu_quota{namespace=~\"pfa|pfa-system\",pod=~\"$pod\",container!=\"\",container!=\"POD\"} / container_spec_cpu_period{namespace=~\"pfa|pfa-system\",pod=~\"$pod\",container!=\"\",container!=\"POD\"}))) and on(pod) (max by (pod) (container_last_seen{namespace=~\"pfa|pfa-system\"} @ end()) > scalar(max(timestamp(container_last_seen{namespace=~\"pfa|pfa-system\"} @ end()))) - 120)",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory usage % by pod",
      "description": "Working set as a percentage of each pod memory limit. Use the Workload group selector to reduce clutter.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "id": 5,
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          },
          "expr": "(100 * (sum by (pod) (container_memory_working_set_bytes{namespace=~\"pfa|pfa-system\",pod=~\"$pod\",container!=\"\",container!=\"POD\"})) / (sum by (pod) (container_spec_memory_limit_bytes{namespace=~\"pfa|pfa-system\",pod=~\"$pod\",container!=\"\",container!=\"POD\"}))) and on(pod) (max by (pod) (container_last_seen{namespace=~\"pfa|pfa-system\"} @ end()) > scalar(max(timestamp(container_last_seen{namespace=~\"pfa|pfa-system\"} @ end()))) - 120)",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container restarts by pod (1h)",
      "description": "Restarts in the last hour per pod.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          },
          "expr": "(sum by (pod) (changes(container_start_time_seconds{namespace=~\"pfa|pfa-system\",pod=~\"$pod\",container!=\"\",container!=\"POD\"}[1h]))) and on(pod) (max by (pod) (container_last_seen{namespace=~\"pfa|pfa-system\"} @ end()) > scalar(max(timestamp(container_last_seen{namespace=~\"pfa|pfa-system\"} @ end()))) - 120)",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "type": "table",
      "title": "Current memory by pod",
      "description": "Current working set for each selected pod, sorted highest first.",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          },
          "expr": "sort_desc(sum by (namespace,pod) (container_memory_working_set_bytes{namespace=~\"pfa|pfa-system\",pod=~\"$pod\",container!=\"\",container!=\"POD\"}))",
          "legendFormat": "{{namespace}} / {{pod}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
    {
      "type": "table",
      "title": "Current CPU by pod",
      "description": "Average CPU cores used over the last 5 minutes, sorted highest first.",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          },
          "expr": "sort_desc(sum by (namespace,pod) (rate(container_cpu_usage_seconds_total{namespace=~\"pfa|pfa-system\",pod=~\"$pod\",container!=\"\",container!=\"POD\"}[5m])))",
          "legendFormat": "{{namespace}} / {{pod}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    }
  ],
