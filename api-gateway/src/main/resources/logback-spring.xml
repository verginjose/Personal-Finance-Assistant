<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
      Two output formats:

        default            human-readable console line, for local runs
        structured-logs    one-line JSON consumed by Vector and stored in
                           ClickHouse; activated by SPRING_PROFILES_ACTIVE in
                           Kubernetes (see k8s/apps/*.yaml)

      Keeping JSON in the cluster is what lets Vector populate the service,
      level, logger, thread and trace columns instead of guessing with regexes.
    -->
    <springProfile name="structured-logs">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>spanId</includeMdcKeyName>
                <fieldNames>
                    <version>[ignore]</version>
                    <levelValue>[ignore]</levelValue>
                </fieldNames>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

    <springProfile name="!structured-logs">
        <!--
          Defined inside this profile only. A top-level appender that the active
          profile never references makes logback warn "Appender named [CONSOLE]
          not referenced" on every structured-logs startup.
        -->
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
