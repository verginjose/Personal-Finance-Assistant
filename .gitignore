# Maven
target/
*.class

# IDEs and Editors
.idea/
*.iml
.vscode/

# Environment
.env
# Per-service overrides may hold real credentials; the committed env/<svc>.env
# files contain only variable names and non-secret defaults.
env/*.local.env

# Frontend
frontend/node_modules/
*.jar
node_modules/
# local pipeline artifacts
.pipeline/

# Sealed Secrets private key backups — never commit, never move into the repo
# (the real backup lives outside the working tree, e.g. ~/)
*sealed-secrets-key*

# Golden-test artifacts
requests/golden-report*.json
requests/golden-soak-*.log
__pycache__/

# Generated test credentials (passwords)
requests/golden-users*.csv

# CI mTLS material: plaintext CA and certificates. The encrypted copies live in
# k8s/sealed/ci-tls-secrets.yaml; see k8s/ci/gen-tls-certs.sh.
.certs/
