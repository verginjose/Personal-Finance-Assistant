    {
      "id": 15,
      "title": "Cache hit ratio",
      "type": "stat",
      "datasource": {
        "type": "redis-datasource",
        "uid": "redis-ds"
      },
      "description": "keyspace_hits / (keyspace_hits + keyspace_misses) since the last restart. Misses are expected for token and idempotency lookups that are not present. Informational: auth and idempotency lookups routinely miss, so this is not a health threshold.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "redis-datasource",
            "uid": "redis-ds"
          },
          "type": "cli",
          "command": "",
          "query": "eval \"local i = redis.call('info','stats') local h = tonumber(string.match(i,'keyspace_hits:(%d+)')) or 0 local m = tonumber(string.match(i,'keyspace_misses:(%d+)')) or 0 if h + m == 0 then return 0 end return math.floor(h * 100 / (h + m))\" 0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 6,
        "h": 4
      }
    },
